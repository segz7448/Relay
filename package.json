{
  "name": "botmanager",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "prebuild": "expo prebuild",
    "check": "npx expo export --platform web --output-dir /tmp/relay-web-check",
    "export:web": "expo export --platform web --output-dir dist",
    "parity": "node scripts/check-api-parity.mjs",
    "test:ui": "node --test utils/__tests__/*.test.mjs && node scripts/verify-approved-visual-contract.mjs && node scripts/verify-agent-console.mjs && node scripts/verify-agent-console-wiring.mjs && node scripts/verify-visible-controls.mjs && node scripts/two-peer-call-harness.mjs && node scripts/verify-route-targets.mjs",
    "start:dev-client": "expo start --dev-client",
    "ios": "expo run:ios"
  },
  "dependencies": {
    "@config-plugins/react-native-webrtc": "^10.0.0",
    "@expo/metro-runtime": "~4.0.1",
    "@expo/vector-icons": "14.0.4",
    "@react-native-community/netinfo": "11.4.1",
    "expo": "^52.0.0",
    "expo-asset": "~11.0.5",
    "expo-av": "~15.0.1",
    "expo-blur": "~14.0.1",
    "expo-clipboard": "~7.0.0",
    "expo-constants": "~17.0.0",
    "expo-contacts": "~14.0.1",
    "expo-dev-client": "5.0.20",
    "expo-device": "~7.0.0",
    "expo-document-picker": "~13.0.1",
    "expo-font": "13.0.4",
    "expo-haptics": "~14.0.0",
    "expo-image-picker": "~16.0.1",
    "expo-local-authentication": "~15.0.1",
    "expo-location": "~18.0.1",
    "expo-notifications": "~0.29.0",
    "expo-router": "^4.0.0",
    "expo-screen-orientation": "~8.0.4",
    "expo-secure-store": "~14.0.0",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-incall-manager": "^4.3.0",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "~0.19.13",
    "react-native-webrtc": "^118.0.7"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~18.3.12",
    "babel-preset-expo": "~12.0.0",
    "typescript": "^5.9.3"
  },
  "private": true
}
