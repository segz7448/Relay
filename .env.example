# Local app development only. Android CI gets this from the GitHub repository
# variable CLOUDFLARE_WORKER_URL through app.config.js.
CLOUDFLARE_WORKER_URL=https://botmanager-worker.ayiijumo.workers.dev

# Never commit Cloudflare, FCM, or Android signing credentials.
# Configure persistent values in GitHub Actions secrets.
# Production voice calls require a TURN service; STUN-only is not reliable on restrictive networks.
RELAY_TURN_URLS=turns:turn.example.com:5349
RELAY_TURN_USERNAME=
RELAY_TURN_CREDENTIAL=
